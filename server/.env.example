# Authn — bearer token for /api/internal/* (main backend uses this)
ATR_TIKTOK_SERVER_INTERNAL_TOKEN=replace_me

# Post for Me (postforme.dev) — TikTok auto-publish. See docs/POST_FOR_ME_SETUP.md
ATR_PFM_API_KEY=replace_me

# Discord
ATR_DISCORD_BOT_TOKEN=replace_me
ATR_DISCORD_GUILD_ID=replace_me
ATR_DISCORD_UPLOAD_CHANNEL_ID=replace_me
ATR_DISCORD_REMINDER_CHANNEL_ID=replace_me
ATR_DISCORD_REMINDER_ROLE_ID=replace_me

# Premiere Link — shared secret the Premiere Pro CEP panel presents on the
# /api/cep/ws WebSocket (generate with `openssl rand -hex 32`, paste the same
# value in the panel's "Premiere Link token" setting)
ATR_CEP_LINK_TOKEN=replace_me

# Server
ATR_SERVER_HOST=0.0.0.0
ATR_SERVER_PORT=8000
ATR_PUBLIC_BASE_URL=https://tiktok.sididi.tv

# Facecam editor delivery (optional; existing workflows do not require these)
# If unset, the bot finds/creates #montage-facecam (Manage Channels required).
ATR_DISCORD_FACECAM_CHANNEL_ID=
ATR_FACECAM_DRIVE_CLIENT_ID=
ATR_FACECAM_DRIVE_CLIENT_SECRET=
ATR_FACECAM_DRIVE_REFRESH_TOKEN=
