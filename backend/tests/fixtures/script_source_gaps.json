      ],
      "source_scenes": [
        {
          "scene_index": 25,
          "text": "करना उनका हुनर है क्या तुमारे घर में कोई जगडा है",
          "start_time": 42.86666666666667,
          "end_time": 45.4,
          "is_raw": false
        },
        {
          "scene_index": 26,
          "text": "क्या कोई गंभीर बीमारी है",
          "start_time": 45.4,
          "end_time": 46.7,
          "is_raw": false
        },
        {
          "scene_index": 27,
          "text": "नहीं,",
          "start_time": 46.7,
          "end_time": 47.53333333333333,
          "is_raw": false
        },
        {
          "scene_index": 28,
          "text": "कोई नहीं",
          "start_time": 47.53333333333333,
          "end_time": 48.86666666666667,
          "is_raw": false
        },
        {
          "scene_index": 29,
          "text": "",
          "start_time": 48.86666666666667,
          "end_time": 49.666666666666664,
          "is_raw": false
        },
        {
          "scene_index": 30,
          "text": "मैं तुम्हें दरवाजे तक ले",
          "start_time": 49.666666666666664,
          "end_time": 51.266666666666666,
          "is_raw": false
        },
        {
          "scene_index": 31,
          "text": "जा रहा हूँ अंदर जाना दाई पर निर्भर है कोई मूर्खता मत",
          "start_time": 51.266666666666666,
          "end_time": 54.06666666666667,
          "is_raw": false
        },
        {
          "scene_index": 32,
          "text": "करना करना. मुझे इसे हासिल करना ही",
          "start_time": 54.06666666666667,
          "end_time": 55.5,
          "is_raw": false
        },
        {
          "scene_index": 33,
          "text": "होगा. मैं अपने",
          "start_time": 55.5,
          "end_time": 56.03333333333333,
          "is_raw": false
        },
        {
          "scene_index": 51,
          "text": "से रो रहा है, शायद उसका दम घुट गया है, क्या",
          "start_time": 75.4,
          "end_time": 77.46666666666667,
          "is_raw": false
        },
        {
          "scene_index": 52,
          "text": "तुम मुझे बता रहे हो कि मैं गलत हूँ,",
          "start_time": 77.46666666666667,
          "end_time": 78.93333333333334,
          "is_raw": false
        },
        {
          "scene_index": 53,
          "text": "मेरी है, मेरी",
          "start_time": 78.93333333333334,
          "end_time": 79.53333333333333,
          "is_raw": false
        },
        {
          "scene_index": 54,
          "text": "हिम्मत नहीं है",
          "start_time": 79.53333333333333,
          "end_time": 80.23333333333333,
          "is_raw": false
        },
        {
          "scene_index": 55,
          "text": "",
          "start_time": 80.23333333333333,
          "end_time": 81.03333333333333,
          "is_raw": false
        },
        {
          "scene_index": 56,
          "text": "नबजा बहुत धीमी है रोने",
          "start_time": 81.03333333333333,
          "end_time": 82.73333333333333,
          "is_raw": false
        },
        {
          "scene_index": 57,
          "text": "से उर्जा को नुकसान",
          "start_time": 82.73333333333333,
          "end_time": 83.33333333333333,
          "is_raw": false
        },
        {
          "scene_index": 58,
          "text": "पहुँचता है और चिलाना बंद करो",
          "start_time": 83.33333333333333,
          "end_time": 84.83333333333333,
          "is_raw": false
        },
        {
          "scene_index": 59,
          "text": "",
          "start_time": 84.83333333333333,
          "end_time": 85.33333333333333,
          "is_raw": false
        },
        {
          "scene_index": 60,
          "text": "",
          "start_time": 85.33333333333333,
          "end_time": 85.86666666666666,
          "is_raw": false
        },
        {
          "scene_index": 61,
          "text": "",
          "start_time": 85.86666666666666,
          "end_time": 86.6,
          "is_raw": false
        },
        {
          "scene_index": 62,
          "text": "बुढ़े सैम तुम किसे ले आए",
          "start_time": 86.6,
          "end_time": 87.86666666666666,
          "is_raw": false
        },
        {
          "scene_index": 63,
          "text": "ये",
          "start_time": 87.86666666666666,
          "end_time": 88.5,
          "is_raw": false
        },
        {
          "scene_index": 64,
          "text": "जगए बाहर की किसी",
          "start_time": 88.5,
          "end_time": 89.26666666666667,
          "is_raw": false
        },
        {
          "scene_index": 65,
          "text": "लड़की के लिए नहीं है दाई",
          "start_time": 89.26666666666667,
          "end_time": 91.3,
          "is_raw": false
        },
        {
          "scene_index": 88,
          "text": "कह सकती हूँ कि यह पैर की",
          "start_time": 127.3,
          "end_time": 128.6,
          "is_raw": false
        },
        {
          "scene_index": 89,
          "text": "समस्या है। बायाओं पैर ज्यादा",
          "start_time": 128.6,
          "end_time": 129.86666666666667,
          "is_raw": false
        },
        {
          "scene_index": 90,
          "text": "सिकोड रहा है। लगता है जैसे वह भी",
          "start_time": 129.86666666666667,
          "end_time": 131.66666666666666,
          "is_raw": false
        },
        {
          "scene_index": 91,
          "text": "बकवास कर रही हो",
          "start_time": 131.66666666666666,
          "end_time": 132.6,
          "is_raw": false
        },
        {
          "scene_index": 92,
          "text": "",
          "start_time": 132.6,
          "end_time": 133.66666666666666,
          "is_raw": false
        },
        {
          "scene_index": 93,
          "text": "ड्यूक साहब",
          "start_time": 133.66666666666666,
          "end_time": 134.26666666666668,
          "is_raw": false
        },
        {
          "scene_index": 94,
          "text": "हम पैर की जाच कर चुके हैं",
          "start_time": 134.26666666666668,
          "end_time": 135.26666666666668,
          "is_raw": false
        },
        {
          "scene_index": 95,
          "text": "मैंने अपनी आखों से देखा",
          "start_time": 135.26666666666668,
          "end_time": 136.33333333333334,
          "is_raw": false
        },
        {
          "scene_index": 96,
          "text": "है कि उसे कोई चोट नहीं लगी है मोजा बहुत",
          "start_time": 136.33333333333334,
          "end_time": 138.23333333333332,
          "is_raw": false
        },
        {
          "scene_index": 98,
          "text": "बच्चा चेड़",
          "start_time": 139.03333333333333,
          "end_time": 139.46666666666667,
          "is_raw": false
        },
        {
          "scene_index": 99,
          "text": "रहा है",
          "start_time": 139.46666666666667,
          "end_time": 140.03333333333333,
          "is_raw": false
        },
        {
          "scene_index": 100,
          "text": "और बच्चा फिर",
          "start_time": 140.03333333333333,
          "end_time": 140.66666666666666,
          "is_raw": false
        },
        {
          "scene_index": 101,
          "text": "परेशान करने लगा ड्यूक साहब देखिए इसे चूबी नहीं सकते",
          "start_time": 140.66666666666666,
          "end_time": 143.86666666666667,
          "is_raw": false
        },
