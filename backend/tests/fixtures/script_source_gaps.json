      "source_scenes": [
        {
          "scene_index": 23,
          "text": "कैल्शियम कार्बोनेट होता है, सांद्रित पानी इसे गोल देता है, और सी ओ तू",
          "start_time": 31.766666666666666,
          "end_time": 34.733333333333334,
          "is_raw": false
        },
        {
          "scene_index": 24,
          "text": "चोड़ता है।",
          "start_time": 34.733333333333334,
          "end_time": 35.46666666666667,
          "is_raw": false
        },
        {
          "scene_index": 25,
          "text": "इसका मतलब है कि बर्फ अम्लिय है,",
          "start_time": 35.46666666666667,
          "end_time": 36.833333333333336,
          "is_raw": false
        },
        {
          "scene_index": 26,
          "text": "आपको अभी कुण नहीं",
          "start_time": 36.833333333333336,
          "end_time": 37.36666666666667,
          "is_raw": false
        },
        {
          "scene_index": 27,
          "text": "",
          "start_time": 37.36666666666667,
          "end_time": 37.733333333333334,
          "is_raw": false
        },
        {
          "scene_index": 28,
          "text": "खुन असमभम ये पूरी तरह से पागल हो",
          "start_time": 37.733333333333334,
          "end_time": 39.833333333333336,
          "is_raw": false
        },
        {
          "scene_index": 29,
          "text": "गया हैं। लाल गोधूली,",
          "start_time": 39.833333333333336,
          "end_time": 40.833333333333336,
          "is_raw": false
        },
        {
          "scene_index": 30,
          "text": "नीला सुरज",
          "start_time": 40.833333333333336,
          "end_time": 41.7,
          "is_raw": false
        },
        {
          "scene_index": 31,
          "text": "और अम्लीय",
          "start_time": 41.7,
          "end_time": 42.06666666666667,
          "is_raw": false
        },
        {
          "scene_index": 46,
          "text": "आब इन गरों में नहीं रह सकते। अरे उसे",
          "start_time": 58.86666666666667,
          "end_time": 60.93333333333333,
          "is_raw": false
        },
        {
          "scene_index": 47,
          "text": "देखो वा अपनी घर को भी तुक्रा रहा है।",
          "start_time": 60.93333333333333,
          "end_time": 62.833333333333336,
          "is_raw": false
        },
        {
          "scene_index": 48,
          "text": "चलो देखते हैं।",
          "start_time": 62.833333333333336,
          "end_time": 63.666666666666664,
          "is_raw": false
        },
        {
          "scene_index": 49,
          "text": "उसका पीछा करते हैं।",
          "start_time": 63.666666666666664,
          "end_time": 65.16666666666667,
          "is_raw": false
        },
        {
          "scene_index": 50,
          "text": "",
          "start_time": 65.16666666666667,
          "end_time": 65.8,
          "is_raw": false
        },
        {
          "scene_index": 51,
          "text": "अंकल जांग का घर अजीब",
          "start_time": 65.8,
          "end_time": 66.73333333333333,
          "is_raw": false
        },
        {
          "scene_index": 52,
          "text": "लग रहा है।",
          "start_time": 66.73333333333333,
          "end_time": 67.63333333333334,
          "is_raw": false
        },
        {
          "scene_index": 53,
          "text": "धत्तिरे की",
          "start_time": 67.63333333333334,
          "end_time": 68.13333333333334,
          "is_raw": false
        },
        {
          "scene_index": 54,
          "text": "कुछ होने",
          "start_time": 68.13333333333334,
          "end_time": 68.7,
          "is_raw": false
        },
        {
          "scene_index": 55,
          "text": "वाला है।",
          "start_time": 68.7,
          "end_time": 69.26666666666667,
          "is_raw": false
        },
        {
          "scene_index": 56,
          "text": "लिंगषेन, रुको,",
          "start_time": 69.26666666666667,
          "end_time": 70.43333333333334,
          "is_raw": false
        },
        {
          "scene_index": 57,
          "text": "",
          "start_time": 70.43333333333334,
          "end_time": 71.06666666666666,
          "is_raw": false
        },
        {
          "scene_index": 58,
          "text": "तुम्हें क्या हो गया है,",
          "start_time": 71.06666666666666,
          "end_time": 72.1,
          "is_raw": false
        },
        {
          "scene_index": 59,
          "text": "बहुत थंड है,",
          "start_time": 72.1,
          "end_time": 72.96666666666667,
          "is_raw": false
        },
        {
          "scene_index": 60,
          "text": "तुम भाहर क्यूं जा रहे हो,",
          "start_time": 72.96666666666667,
          "end_time": 74.36666666666666,
          "is_raw": false
        },
        {
          "scene_index": 61,
          "text": "अंकल जी आंग, बहुत",
          "start_time": 74.36666666666666,
          "end_time": 75.76666666666667,
          "is_raw": false
        },
        {
          "scene_index": 88,
          "text": "इनके अंदर नहीं सोना चाहिये।",
          "start_time": 110.7,
          "end_time": 112.26666666666667,
          "is_raw": false
        },
        {
          "scene_index": 89,
          "text": "बक्वास। जांग",
          "start_time": 112.26666666666667,
          "end_time": 113.63333333333334,
          "is_raw": false
        },
        {
          "scene_index": 90,
          "text": "का घर पूराना था। कोई",
          "start_time": 113.63333333333334,
          "end_time": 114.93333333333334,
          "is_raw": false
        },
        {
          "scene_index": 91,
          "text": "आश्चर्य नहीं।",
          "start_time": 114.93333333333334,
          "end_time": 115.76666666666667,
          "is_raw": false
        },
        {
          "scene_index": 92,
          "text": "",
          "start_time": 115.76666666666667,
          "end_time": 116.16666666666667,
          "is_raw": false
        },
        {
          "scene_index": 93,
          "text": "वरना हम कहां सोएंगे बरफ",
          "start_time": 116.16666666666667,
          "end_time": 117.43333333333334,
          "is_raw": false
        },
        {
          "scene_index": 94,
          "text": "में मरने के लिए। अगर तुम",
          "start_time": 117.43333333333334,
          "end_time": 118.63333333333334,
          "is_raw": false
        },
        {
          "scene_index": 95,
          "text": "जीना चाते हो",
          "start_time": 118.63333333333334,
          "end_time": 119.0,
          "is_raw": false
        },
        {
          "scene_index": 96,
          "text": "तो मेरे पीछे आओं। शंकर,",
          "start_time": 119.0,
          "end_time": 120.43333333333334,
          "is_raw": false
        },
        {
          "scene_index": 261,
          "text": "जलता नहीं है, इसके गर्मी नहीं मिलती, और",
          "start_time": 327.8,
          "end_time": 329.73333333333335,
          "is_raw": false
        },
        {
          "scene_index": 262,
          "text": "इसके खासी होती है, इसके बदले एक घर,",
          "start_time": 329.73333333333335,
          "end_time": 332.26666666666665,
          "is_raw": false
        },
        {
          "scene_index": 263,
          "text": "वह सच्मुच पागल हो गया है, कोईले का पत्थर, ये",
          "start_time": 332.26666666666665,
          "end_time": 335.06666666666666,
          "is_raw": false
        },
        {
          "scene_index": 264,
          "text": "खडानों का कछ्रा है, जो अशु",
          "start_time": 335.06666666666666,
          "end_time": 336.5,
          "is_raw": false
        },
        {
          "scene_index": 265,
          "text": "",
          "start_time": 336.5,
          "end_time": 337.6,
          "is_raw": false
        },
        {
          "scene_index": 266,
          "text": "गरीब लोग भी इसे नहीं चाहते।",
          "start_time": 337.6,
          "end_time": 338.76666666666665,
          "is_raw": false
        },
        {
          "scene_index": 267,
          "text": "उसे कुछ नहीं पता।",
          "start_time": 338.76666666666665,
          "end_time": 340.06666666666666,
          "is_raw": false
        },
        {
          "scene_index": 268,
          "text": "अगर तुम अदला बद्ली करना",
          "start_time": 340.06666666666666,
          "end_time": 341.4,
          "is_raw": false
        },
        {
          "scene_index": 269,
          "text": "चाहते हो, तो मैं तुम्हें इसके अनुमती",
          "start_time": 341.4,
          "end_time": 342.96666666666664,
          "is_raw": false
        }
      ]
    },
    {
      "project_id": "27cd1cecf30f",
      "source_language": "es",
      "scene_count": 123,
      "missing_indices": [
        62,
        105
      ],
      "source_scenes": [
        {
          "scene_index": 58,
          "text": "¿Qué? ¿Sin dote? Entonces, ¿para qué subiste? Cree que por ser bonita ya puede.",
          "start_time": 155.0,
          "end_time": 158.2,
          "is_raw": false
        },
        {
          "scene_index": 59,
          "text": "Es una pobre. Exacto. ¿Qué haces ahí? Bájate.",
          "start_time": 158.2,
          "end_time": 161.3,
          "is_raw": false
        },
        {
          "scene_index": 60,
          "text": "Lo siento.",
          "start_time": 161.3,
          "end_time": 162.13333333333333,
          "is_raw": false
        },
        {
          "scene_index": 61,
          "text": "¿Qué esperas? ¡Vete!",
          "start_time": 162.13333333333333,
          "end_time": 163.7,
          "is_raw": false
        },
        {
          "scene_index": 62,
          "text": "",
          "start_time": 163.7,
          "end_time": 164.33333333333334,
          "is_raw": false
        },
        {
          "scene_index": 63,
          "text": "No hay que elegir más.",
          "start_time": 164.33333333333334,
          "end_time": 165.46666666666667,
          "is_raw": false
        },
        {
          "scene_index": 64,
          "text": "La elijo a ella.",
          "start_time": 165.46666666666667,
          "end_time": 166.26666666666668,
          "is_raw": false
        },
        {
          "scene_index": 65,
          "text": "Bebé, tienes el control.",
          "start_time": 166.26666666666668,
          "end_time": 167.63333333333333,
          "is_raw": false
        },
        {
          "scene_index": 66,
          "text": "¿Qué pasa? ¿Ahora los hombres tienen gustos tan raros?",
          "start_time": 167.63333333333333,
          "end_time": 170.16666666666666,
          "is_raw": false
        },
        {
          "scene_index": 101,
          "text": "¡Qué guapo! Yo también quiero ser su novia.",
          "start_time": 256.03333333333336,
          "end_time": 257.93333333333334,
          "is_raw": false
        },
        {
          "scene_index": 102,
          "text": "Ay, mamá, igual de guapo que",
          "start_time": 257.93333333333334,
          "end_time": 259.1,
          "is_raw": false
        },
        {
          "scene_index": 103,
          "text": "en la pantalla.",
          "start_time": 259.1,
          "end_time": 259.9,
          "is_raw": false
        },
        {
          "scene_index": 104,
          "text": "Sí, sí. Un chico tan guapo. ¿Por qué no es mi esposo? ¡Qué suerte tiene la chica de al lado! ¿Tú?",
          "start_time": 259.9,
          "end_time": 264.53333333333336,
          "is_raw": false
        },
        {
          "scene_index": 105,
          "text": "",
          "start_time": 264.53333333333336,
          "end_time": 264.96666666666664,
          "is_raw": false
        },
        {
          "scene_index": 106,
          "text": "Bueno, dos tés de leche con perlas. Muchas perlas, sin té.",
          "start_time": 264.96666666666664,
          "end_time": 267.53333333333336,
          "is_raw": false
        },
        {
          "scene_index": 107,
          "text": "¿Vienes a molestarme? Té de leche con perlas sin té. Te voy a",
          "start_time": 267.53333333333336,
          "end_time": 270.43333333333334,
          "is_raw": false
        },
        {
          "scene_index": 108,
          "text": "dar.",
          "start_time": 270.43333333333334,
          "end_time": 270.8666666666667,
          "is_raw": false
        },
        {
          "scene_index": 109,
          "text": "Guau, qué guapo. Claro, guapo, lo hago ya. Es té de leche con perlas, claro.",
          "start_time": 270.8666666666667,
          "end_time": 274.4,
          "is_raw": false
        }
      ]
    },
    {
      "project_id": "cb5ed12bdee5",
      "source_language": "hi",
      "scene_count": 134,
      "missing_indices": [
        29,
