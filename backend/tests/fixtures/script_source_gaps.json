          "scene_index": 102,
          "text": "",
          "start_time": 143.86666666666667,
          "end_time": 144.2,
          "is_raw": false
        },
        {
          "scene_index": 103,
          "text": "",
          "start_time": 144.2,
          "end_time": 145.23333333333332,
          "is_raw": false
        },
        {
          "scene_index": 104,
          "text": "तुम कहती हो कि पैर में दिक्कत",
          "start_time": 145.23333333333332,
          "end_time": 146.5,
          "is_raw": false
        },
        {
          "scene_index": 105,
          "text": "है तो इसकी जांच कैसे",
          "start_time": 146.5,
          "end_time": 147.4,
          "is_raw": false
        },
        {
          "scene_index": 106,
          "text": "करोगी मोजा उतारना",
          "start_time": 147.4,
          "end_time": 148.4,
          "is_raw": false
        },
        {
          "scene_index": 107,
          "text": "नहीं बच्चा तीन दिन तक रोएगा तलवा हवा बरदाश्ट नहीं कर सकता ये मोजे बड़ी मालकिन ने बनवाय थे",
          "start_time": 148.4,
          "end_time": 152.86666666666667,
          "is_raw": false
        },
        {
          "scene_index": 117,
          "text": "है तो हम इसे वापस पहना देंगे इसे",
          "start_time": 170.73333333333332,
          "end_time": 172.4,
          "is_raw": false
        },
        {
          "scene_index": 118,
          "text": "उतारो इसे जोर",
          "start_time": 172.4,
          "end_time": 173.26666666666668,
          "is_raw": false
        },
        {
          "scene_index": 119,
          "text": "से मत खींचो, जिसे समझ है वही करे, ऐसा लगता है",
          "start_time": 173.26666666666668,
          "end_time": 175.8,
          "is_raw": false
        },
        {
          "scene_index": 120,
          "text": "कि बच्चा नहीं चाहता कि मैं उसे चूँ, तुम जाओ,",
          "start_time": 175.8,
          "end_time": 177.43333333333334,
          "is_raw": false
        },
        {
          "scene_index": 121,
          "text": "",
          "start_time": 177.43333333333334,
          "end_time": 178.33333333333334,
          "is_raw": false
        },
        {
          "scene_index": 122,
          "text": "जल्दी",
          "start_time": 178.33333333333334,
          "end_time": 180.0,
          "is_raw": false
        },
        {
          "scene_index": 123,
          "text": "करो, सबके सब अनाडी हैं,",
          "start_time": 180.0,
          "end_time": 181.53333333333333,
          "is_raw": false
        },
        {
          "scene_index": 124,
          "text": "इसे सावधानी से करो,",
          "start_time": 181.53333333333333,
          "end_time": 182.26666666666668,
          "is_raw": false
        },
        {
          "scene_index": 125,
          "text": "अगर दर्द",
          "start_time": 182.26666666666668,
          "end_time": 183.06666666666666,
